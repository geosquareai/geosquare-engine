{
  "name": "geosquare-engine",
  "version": "0.1.0",
  "description": "GeoSquare V2 grid engine for JavaScript and the browser: GID codec, BigInt packing, topology, and column detection (spec 2.0).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "pkg/geosquare_wasm.js",
  "exports": {
    ".": "./pkg/geosquare_wasm.js",
    "./rollup": "./js/rollup.mjs",
    "./pkg/*": "./pkg/*",
    "./cells": "./js/cells.mjs",
    "./deck": "./js/deck.mjs"
  },
  "types": "pkg/geosquare_wasm.d.ts",
  "files": [
    "pkg/geosquare_wasm.js",
    "pkg/geosquare_wasm.d.ts",
    "pkg/geosquare_wasm_bg.wasm",
    "pkg/geosquare_wasm_bg.wasm.d.ts",
    "js/rollup.mjs",
    "README.md",
    "js/cells.mjs",
    "js/deck.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "cargo build --release --locked --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir pkg target/wasm32-unknown-unknown/release/geosquare_wasm.wasm",
    "test": "node --test \"tests/*.test.mjs\"",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0"
  },
  "devDependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0"
  }
}
